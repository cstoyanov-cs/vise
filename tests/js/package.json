{
  "name": "vise-client-tests",
  "version": "1.0.0",
  "description": "JavaScript tests for Vise client modules",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^22.1.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "client/**/*.js",
      "test/**/*.js",
      "!node_modules/**"
    ],
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/node_modules/"
    ]
  }
}
