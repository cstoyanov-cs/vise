{
  "name": "vise-client-tests",
  "version": "1.0.0",
  "description": "JavaScript tests for Vise client modules",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage --collectCoverageFrom=/home/opencode/DEV/vise/.worktrees/vise-dev/vise/data/js/hints.js test/hints.test.js",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^22.1.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "collectCoverageFrom": [
      "/home/opencode/DEV/vise/.worktrees/vise-dev/vise/data/js/**/*.js"
    ],
    "coverageThreshold": {
      "/home/opencode/DEV/vise/.worktrees/vise-dev/vise/data/js/hints.js": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    },
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/node_modules/"
    ]
  }
}
